# Copy to infra/.env and fill in. Never commit infra/.env (it is git-ignored).
STACK_NAME=pixel-pals
AWS_REGION=eu-west-1

# From Google Cloud Console → APIs & Services → Credentials → OAuth client (Web application)
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxx

# Globally unique, lowercase; becomes <prefix>.auth.<region>.amazoncognito.com
COGNITO_DOMAIN_PREFIX=pixel-pals-yourfamily

# Google accounts allowed to sign in (comma separated). These are the parents' accounts.
ALLOWED_EMAILS=you@gmail.com,partner@gmail.com
